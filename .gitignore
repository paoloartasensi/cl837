# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android Studio build artifacts and CMake related
/android/app/.cxx/
/android/**/.cxx/
android/app/.cxx/RelWithDebInfo/
**/CMakeFiles/
**/CMakeCCompilerId.c
**/CMakeCXXCompilerId.cpp

# Project specific directories to ignore

/tools/
/REVERSE/CL831_DECOMPILED/
/REVERSE_script/

# Lock files that can cause merge conflicts
pubspec.lock

# Heap dump files and debugging files
*.hprof
*.log
android/*.hprof
android/**/*.hprof
android/*.log
android/**/*.log

# Error logs and replay files
hs_err_pid*.log
replay_pid*.log